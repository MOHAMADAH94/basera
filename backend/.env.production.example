# بعد تفعيل AutoSSL غيّر إلى https في CSRF والتطبيق
DEBUG=False
SECRET_KEY=غيّر-هذا-إلى-مفتاح-عشوائي-طويل

ALLOWED_HOSTS=basera.mobishop.online,www.basera.mobishop.online
CSRF_TRUSTED_ORIGINS=http://basera.mobishop.online,https://basera.mobishop.online

# MySQL من cPanel → MySQL Databases
DB_ENGINE=mysql
DB_NAME=اسم_قاعدة_البيانات
DB_USER=اسم_المستخدم
DB_PASSWORD=كلمة_المرور
DB_HOST=localhost
DB_PORT=3306

CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://basera.mobishop.online,https://basera.mobishop.online

# اتركها False طالما الموقع على http فقط
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# توليد صوت من النص/PDF على السيرفر (gTTS) — مطلوب لمسار PDF→صوت
ENABLE_SERVER_TTS=True
